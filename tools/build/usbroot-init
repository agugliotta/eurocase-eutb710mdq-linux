#!/bin/sh
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /sys/kernel/config
mount -t configfs configfs /sys/kernel/config
sh /setup-usb.sh
setup_rc=$?
echo "USBROOT_SETUP_RC=$setup_rc" > /dev/kmsg
while true; do
    if test -c /dev/ttyGS0; then
        setsid sh -c '
            exec 0<>/dev/ttyGS0
            exec 1>&0 2>&0
            stty clocal -hupcl -ixon -ixoff
            echo EUROCASE_MAINLINE_USB_SHELL
            uname -a
            exec sh -i
        '
    fi
    sleep 1
done
